#!/bin/sh
# Rejects a commit that puts a personal signing team back into an Xcode project.
# Enable once per clone: git config core.hooksPath .githooks
if git diff --cached -U0 -- '*.pbxproj' | grep -E '^\+.*DEVELOPMENT_TEAM' >/dev/null; then
    echo "pre-commit: DEVELOPMENT_TEAM is staged in project.pbxproj." >&2
    echo "Put it in ios/Signing.local.xcconfig instead (see ios/Signing.xcconfig)," >&2
    echo "then restore the project file: git checkout -- '*.pbxproj'" >&2
    exit 1
fi
