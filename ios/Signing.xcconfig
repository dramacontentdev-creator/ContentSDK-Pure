// Signing for running the demo on a device. Do not set the team in Xcode's Signing & Capabilities
// tab: that writes it into project.pbxproj. Instead create Signing.local.xcconfig next to this file
// (it is git-ignored) with your own values, for example:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   PRODUCT_BUNDLE_IDENTIFIER = com.yourcompany.contentsdk.demo.pure
//
// The simulator needs neither.
PRODUCT_BUNDLE_IDENTIFIER = com.lc.content.sdk.demo.ios.pure

#include? "Signing.local.xcconfig"
