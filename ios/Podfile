# Content SDK - integration Step 1 (dependencies)
#
# 1. Download the pure iOS SDK package (ContentSdk-pure-iOS-YOUR_SDK_VERSION-release).
# 2. Copy its whole content into ./ContentSdkPure next to this Podfile
#    (ContentSdkPure.podspec, ContentSdk.xcframework, compose-resources, ...).
# 3. Run `pod install`, then open ContentSdkDemo.xcworkspace (not the .xcodeproj).
#
# The Pod brings the SDK and its resources. The pure edition has no ad dependencies.
# The Swift module is still `ContentSdk`: keep `import ContentSdk`.
# Do NOT also drag ContentSdk.xcframework into Xcode manually.

source 'https://cdn.cocoapods.org/'
platform :ios, '16.0'
use_frameworks!

unless File.exist?(File.join(__dir__, 'ContentSdkPure', 'ContentSdkPure.podspec'))
  abort("Content SDK package not found: copy the pure iOS SDK package content into ./ContentSdkPure " \
        "(ContentSdkPure.podspec, ContentSdk.xcframework, compose-resources, ...). See README.")
end

target 'ContentSdkDemo' do
  pod 'ContentSdkPure', :path => './ContentSdkPure'
end
